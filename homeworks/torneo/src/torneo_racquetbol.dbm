<table name="set_partido" layers="0" collapse-mode="2" max-obj-count="4" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<comment> <![CDATA[MAESTRO-DETALLE]]> </comment>
	<position x="1780" y="520"/>
	<column name="nro_set" not-null="true">
		<type name="smallint" length="0"/>
	</column>
	<column name="puntos_j1" not-null="true" default-value="0">
		<type name="smallint" length="0"/>
	</column>
	<column name="puntos_j2" not-null="true" default-value="0">
		<type name="smallint" length="0"/>
	</column>
	<constraint name="set_partido_pk" type="pk-constr" table="public.set_partido">
		<columns names="nro_set" ref-type="src-columns"/>
	</constraint>
	<constraint name="chk_rango_sets" type="ck-constr" table="public.set_partido">
			<expression> <![CDATA[nro_set BETWEEN 1 and 5]]> </expression>
	</constraint>
	<constraint name="chk_puntos_no_negativos" type="ck-constr" table="public.set_partido">
			<expression> <![CDATA[puntos_j1 >= 0 AND puntos_j2 >= 0]]> </expression>
	</constraint>

	<customidxs object-type="column">
		<object name="id_partido" index="3"/>
	</customidxs>
	<customidxs object-type="constraint">
		<object name="partido_fk" index="1"/>
	</customidxs></table>


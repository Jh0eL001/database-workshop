<table name="partido" layers="0" collapse-mode="2" max-obj-count="14" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<comment> <![CDATA[el punto de encuentro donde convergen la cancha, la etapa, el árbitro y los dos contrincantes.]]> </comment>
	<position x="1080" y="300"/>
	<column name="id_partido" not-null="true">
		<type name="serial" length="0"/>
	</column>
	<column name="fecha_hora" not-null="true">
		<type name="timestamp" length="0"/>
	</column>
	<constraint name="partido_pk" type="pk-constr" table="public.partido">
		<columns names="id_partido" ref-type="src-columns"/>
	</constraint>
	<constraint name="chk_jugadores_distintos" type="ck-constr" table="public.partido">
			<expression> <![CDATA[id_persona_j1 <> id_persona_j2 AND id_torneo_j1 = id_torneo_j2]]> </expression>
	</constraint>

	<customidxs object-type="column">
		<object name="cod_fase" index="3"/>
		<object name="fecha_inscripcion_j1" index="6"/>
		<object name="fecha_inscripcion_j2" index="9"/>
		<object name="id_arbitro" index="5"/>
		<object name="id_grupo" index="4"/>
		<object name="id_persona_j1" index="8"/>
		<object name="id_persona_j2" index="11"/>
		<object name="id_torneo_j1" index="7"/>
		<object name="id_torneo_j2" index="10"/>
		<object name="nro_cancha" index="2"/>
	</customidxs>
	<customidxs object-type="constraint">
		<object name="arbitro_fk" index="4"/>
		<object name="cancha_fk" index="1"/>
		<object name="fase_fk" index="2"/>
		<object name="grupo_fk" index="3"/>
		<object name="registro_jugador_fk" index="6"/>
		<object name="registro_jugador_fk1" index="7"/>
	</customidxs></table>


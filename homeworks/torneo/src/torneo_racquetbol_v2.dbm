<table name="inscripcion" layers="0" collapse-mode="2" max-obj-count="4" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<comment> <![CDATA[tabla composicion para torneo y jugador.]]> </comment>
	<position x="540" y="620"/>
	<column name="fecha_inscripcion" not-null="true">
		<type name="date" length="0"/>
	</column>
	<column name="monto_pago" not-null="true">
		<type name="numeric" length="8" precision="2"/>
	</column>
	<constraint name="inscripcion_pk" type="pk-constr" table="public.inscripcion">
		<columns names="fecha_inscripcion" ref-type="src-columns"/>
	</constraint>
</table>

<relationship name="torneo tiene varias inscripciones" type="rel1n" layers="0"
	 src-col-pattern="{sc}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 custom-color="#7886a5"
	 src-table="public.torneo"
	 dst-table="public.inscripcion"
	 src-required="true" dst-required="false"
	 identifier="true"
>
	<label ref-type="name-label">
		<position x="-63.6577" y="1.85152"/>
	</label>
</relationship>

<relationship name="jugador_has_many_inscripciones" type="rel1n" layers="0"
	 src-col-pattern="{sc}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 custom-color="#97a183"
	 src-table="public.jugador"
	 dst-table="public.inscripcion"
	 src-required="true" dst-required="false"
	 identifier="true"
>
	<label ref-type="name-label">
		<position x="-178.996" y="92.2515"/>
	</label>
</relationship>

<table name="partido" layers="0" collapse-mode="2" max-obj-count="8" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<comment> <![CDATA[el punto de encuentro donde convergen la cancha, la etapa, el árbitro y los dos contrincantes.]]> </comment>
	<position x="960" y="400"/>
	<column name="id_partido" not-null="true">
		<type name="serial" length="0"/>
	</column>
	<column name="fecha_hora" not-null="true">
		<type name="timestamp" length="0"/>
	</column>
	<constraint name="partido_pk" type="pk-constr" table="public.partido">
		<columns names="id_partido" ref-type="src-columns"/>
	</constraint>
	<constraint name="chk_jugadores_distintos" type="ck-constr" table="public.partido">
			<expression> <![CDATA[id_jugador_1 <> id_jugador_2]]> </expression>
	</constraint>

	<customidxs object-type="column">
		<object name="cod_fase" index="3"/>
		<object name="id_arbitro" index="4"/>
		<object name="id_jugador_1" index="5"/>
		<object name="id_jugador_2" index="6"/>
		<object name="nro_cancha" index="2"/>
	</customidxs>
	<customidxs object-type="constraint">
		<object name="arbitro_fk" index="4"/>
		<object name="cancha_fk" index="1"/>
		<object name="fase_fk" index="2"/>
		<object name="jugador_fk" index="5"/>
		<object name="jugador_fk1" index="6"/>
	</customidxs></table>

<relationship name="cancha_has_many_partidos" type="rel1n" layers="0"
	 src-col-pattern="{sc}"

<dbmodel pgmodeler-ver="1.1.0-beta1" use-changelog="false" last-position="0,0" last-zoom="0.8" max-obj-count="13"
	 default-schema="public" default-owner="postgres"
	 layers="Default layer"
	 active-layers="0"
	 layer-name-colors="#000000"
	 layer-rect-colors="#b4b4b4"
	 show-layer-names="false" show-layer-rects="false">
<database name="new_database" is-template="false" allow-conns="true">
</database>

<schema name="public" layers="0" fill-color="#e1e1e1" name-color="#000000" sql-disabled="true">
</schema>

<table name="categoria" layers="0" collapse-mode="2" max-obj-count="3" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<comment> <![CDATA[categoria (padre) ----->  grupo (hija). Idiom Clasificador.]]> </comment>
	<position x="480" y="120"/>
	<column name="cod_categoria" not-null="true">
		<type name="varchar" length="10"/>
	</column>
	<column name="nombre" not-null="true">
		<type name="varchar" length="50"/>
	</column>
	<column name="descripcion">
		<type name="varchar" length="100"/>
	</column>
	<constraint name="categoria_pk" type="pk-constr" table="public.categoria">
		<columns names="cod_categoria" ref-type="src-columns"/>
	</constraint>
</table>

<table name="torneo" layers="0" collapse-mode="2" max-obj-count="4" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="340" y="300"/>
	<column name="id_torneo" not-null="true">
		<type name="serial" length="0"/>
	</column>
	<column name="nombre" not-null="true">
		<type name="varchar" length="80"/>
	</column>
	<column name="fecha_inicio" not-null="true">
		<type name="date" length="0"/>
	</column>
	<column name="fecha_fin" not-null="true">
		<type name="date" length="0"/>
	</column>
	<constraint name="torneo_pk" type="pk-constr" table="public.torneo">
		<columns names="id_torneo" ref-type="src-columns"/>
	</constraint>
</table>

<table name="cancha" layers="0" collapse-mode="2" max-obj-count="3" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<comment> <![CDATA[cancha ---> partido clasificador]]> </comment>
	<position x="920" y="900"/>
	<column name="nro_cancha" not-null="true">
		<type name="integer" length="0"/>
	</column>
	<column name="nombre" not-null="true">
		<type name="varchar" length="50"/>
	</column>
	<column name="disponible" not-null="true" default-value="true">
		<type name="boolean" length="0"/>
	</column>
	<constraint name="cancha_pk" type="pk-constr" table="public.cancha">
		<columns names="nro_cancha" ref-type="src-columns"/>
	</constraint>
	<constraint name="check_rango_canchas" type="ck-constr" table="public.cancha">
			<expression> <![CDATA[nro_cancha BETWEEN 1 AND 12]]> </expression>
	</constraint>
</table>

<table name="fase" layers="0" collapse-mode="2" max-obj-count="3" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="1460" y="900"/>
	<column name="cod_fase" not-null="true">
		<type name="varchar" length="10"/>
	</column>
	<column name="nombre" not-null="true">
		<type name="varchar" length="30"/>
	</column>
	<column name="orden_secuencia" not-null="true">
		<type name="smallint" length="0"/>
	</column>
	<constraint name="fase_pk" type="pk-constr" table="public.fase">
		<columns names="cod_fase" ref-type="src-columns"/>
	</constraint>
</table>

<table name="persona" layers="0" collapse-mode="2" max-obj-count="6" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="1680" y="40"/>
	<column name="id_persona" not-null="true">
		<type name="serial" length="0"/>
	</column>
	<column name="ci" not-null="true">
		<type name="varchar" length="20"/>
	</column>
	<column name="nombre" not-null="true">
		<type name="varchar" length="50"/>
	</column>
	<column name="apellido" not-null="true">
		<type name="varchar" length="50"/>
	</column>
	<column name="telefono" not-null="true">
		<type name="varchar" length="20"/>
	</column>
	<constraint name="persona_pk" type="pk-constr" table="public.persona">
		<columns names="id_persona" ref-type="src-columns"/>
	</constraint>
</table>

<table name="jugador" layers="0" collapse-mode="2" max-obj-count="4" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="1100" y="20"/>
	<column name="mano_habil" not-null="true" default-value="'Diestro'">
		<type name="varchar" length="10"/>
	</column>
	<column name="club_origen" default-value="'Country Club'">
		<type name="varchar" length="20"/>
	</column>

	<customidxs object-type="column">
		<object name="cod_categoria" index="3"/>
		<object name="id_persona" index="2"/>
	</customidxs>
	<customidxs object-type="constraint">
		<object name="categoria_fk" index="2"/>
		<object name="jugador_pk" index="0"/>
		<object name="persona_fk" index="1"/>
	</customidxs></table>

<table name="arbitro" layers="0" collapse-mode="2" max-obj-count="3" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="1660" y="300"/>
	<column name="nivel_certificacion" not-null="true">
		<type name="varchar" length="50"/>
	</column>
	<column name="anios_experiencia" default-value="0">
		<type name="smallint" length="0"/>
	</column>
</table>

<relationship name="jugador_is_A_persona" type="rel11" layers="0"
	 src-col-pattern="{sc}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 custom-color="#835e2f"
	 src-table="public.persona"
	 dst-table="public.jugador"
	 src-required="true" dst-required="false"
	 identifier="true"
>
	<label ref-type="name-label">
		<position x="-6.41082" y="11.8213"/>
	</label>
</relationship>

<relationship name="arbitro_is_A_persona" type="rel11" layers="0"
	 src-col-pattern="{sc}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 custom-color="#2ec79e"
	 src-table="public.persona"
	 dst-table="public.arbitro"
	 src-required="true" dst-required="false"
	 identifier="true"
>
	<label ref-type="name-label">
		<position x="21.4372" y="-27.9485"/>
	</label>
</relationship>

<relationship name="categoria has many jugadores" type="rel1n" layers="0"
	 src-col-pattern="{sc}"

<table name="categoria" layers="0" collapse-mode="2" max-obj-count="3" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<comment> <![CDATA[categoria (padre) ----->  grupo (hija). Idiom Clasificador.]]> </comment>
